        {
          "command": "openLens.manageHelmRepos",
          "when": "view == openLens.clusters",
          "group": "3_misc@3"
        }
      ],
      "view/item/context": [
        {
          "command": "openLens.connect",
          "when": "view == openLens.clusters && viewItem =~ /^context\\.(idle|error|disconnected)/",
          "group": "inline@0"
        },
        {
          "command": "openLens.disconnect",
          "when": "view == openLens.clusters && viewItem =~ /^context\\.(connecting|connected)/",
          "group": "inline@0"
        },
        {
          "command": "openLens.openDashboard",
          "when": "view == openLens.clusters && viewItem =~ /^context\\./",
          "group": "inline@1"
        },
        {
          "command": "openLens.selectNamespace",
          "when": "view == openLens.clusters && viewItem =~ /^context\\./",
          "group": "inline@2"
        },
        {
          "command": "openLens.openDashboard",
          "when": "view == openLens.clusters && viewItem =~ /^context\\./",
          "group": "1_open@1"
        },
        {
          "command": "openLens.goToResource",
