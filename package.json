          "group": "1_open@4"
        },
        {
          "command": "openLens.newResource",
          "when": "view == openLens.clusters && viewItem =~ /^context\\./",
          "group": "1_open@5"
        },
        {
          "command": "openLens.setCurrentContext",
          "when": "view == openLens.clusters && viewItem =~ /^context\\./ && viewItem not =~ /\\.current$/",
          "group": "2_context@1"
        },
        {
          "command": "openLens.setDefaultNamespace",
          "when": "view == openLens.clusters && viewItem =~ /^context\\./",
          "group": "2_context@2"
        },
        {
          "command": "openLens.renameContext",
          "when": "view == openLens.clusters && viewItem =~ /^context\\./",
          "group": "2_context@3"
        },
        {
          "command": "openLens.toggleProtection",
          "when": "view == openLens.clusters && viewItem =~ /^context\\./",
          "group": "2_context@4"
        },
        {
          "command": "openLens.exportContext",
          "when": "view == openLens.clusters && viewItem =~ /^context\\./",
          "group": "2_context@5"
        },
        {
          "command": "openLens.connect",
          "when": "view == openLens.clusters && viewItem =~ /^context\\.(idle|error|disconnected)/",
          "group": "3_connection@1"
        },
        {
          "command": "openLens.disconnect",
          "when": "view == openLens.clusters && viewItem =~ /^context\\.(connecting|connected)/",
          "group": "3_connection@2"
        },
        {
          "command": "openLens.reconnect",
          "when": "view == openLens.clusters && viewItem =~ /^context\\./",
          "group": "3_connection@3"
        },
        {
          "command": "openLens.removeContext",
          "when": "view == openLens.clusters && viewItem =~ /^context\\./",
          "group": "9_danger@1"
        },
        {
          "command": "openLens.openPortForward",
          "when": "view == openLens.portForwards && viewItem == portForward",
          "group": "inline@1"
        },
        {
          "command": "openLens.stopPortForward",
          "when": "view == openLens.portForwards && viewItem == portForward",
          "group": "inline@2"
        },
        {
          "command": "openLens.copyPortForwardUrl",
          "when": "view == openLens.portForwards && viewItem == portForward",
          "group": "1_actions@1"
        },
        {
          "command": "openLens.stopPortForward",
          "when": "view == openLens.portForwards && viewItem == portForward",
          "group": "1_actions@2"
        },
        {
          "command": "openLens.unpinFavorite",
          "when": "view == openLens.favorites && viewItem =~ /^favorite\\./",
          "group": "inline@1"
        },
        {
          "command": "openLens.runDoctor",
          "when": "view == openLens.clusters && viewItem =~ /^context\\./",
          "group": "4_setup@1"
        },
        {
          "command": "openLens.openAddons",
          "when": "view == openLens.clusters && viewItem =~ /^context\\./",
          "group": "4_setup@2"
        },
        {
          "command": "openLens.installChart",
          "when": "view == openLens.clusters && viewItem =~ /^context\\./",
          "group": "4_setup@3"
        },
        {
          "command": "openLens.deployImage",
          "when": "view == openLens.clusters && viewItem =~ /^context\\./",
          "group": "4_setup@4"
        },
        {
          "command": "openLens.onboardTeam",
          "when": "view == openLens.clusters && viewItem =~ /^context\\./",
          "group": "4_setup@5"
        },
        {
          "command": "openLens.newRegistrySecret",
          "when": "view == openLens.clusters && viewItem =~ /^context\\./",
          "group": "5_secrets@1"
        },
        {
          "command": "openLens.newTlsSecret",
          "when": "view == openLens.clusters && viewItem =~ /^context\\./",
          "group": "5_secrets@2"
        },
        {
          "command": "openLens.newSecretFromEnv",
          "when": "view == openLens.clusters && viewItem =~ /^context\\./",
          "group": "5_secrets@3"
        },
        {
          "command": "openLens.newDataFromFiles",
          "when": "view == openLens.clusters && viewItem =~ /^context\\./",
          "group": "5_secrets@4"
        }
      ],
      "editor/title": [
        {
          "command": "openLens.importKubeconfigFromEditor",
          "when": "openLens.editorHasKubeconfig",
          "group": "navigation@1"
        },
        {
          "command": "openLens.helmUpgradeFromEditor",
          "when": "openLens.helmValuesEditor",
          "group": "navigation@1"
        },
        {
          "command": "openLens.diffWithLive",
          "when": "resourceScheme == k8s",
          "group": "navigation@1"
        },
        {
          "command": "openLens.applyYaml",
          "when": "resourceLangId == yaml && !openLens.editorHasKubeconfig && !openLens.helmValuesEditor && !openLens.helmInstallEditor && resourceScheme != k8s && resourceScheme != openlens-view",
          "group": "navigation@2"
        },
        {
          "command": "openLens.helmInstallFromEditor",
          "when": "openLens.helmInstallEditor",
          "group": "navigation@1"
        }
      ],
      "explorer/context": [
        {
          "command": "openLens.importKubeconfig",
          "when": "!explorerResourceIsFolder",
          "group": "7_modification@9"
        },
        {
          "command": "openLens.convertCompose",
          "when": "resourceFilename =~ /^(docker-)?compose.*\\.ya?ml$/",
          "group": "7_modification@10"
        }
      ],
      "commandPalette": [
        {
          "command": "openLens.openTable",
          "when": "false"
        },
        {
          "command": "openLens.openPortForward",
          "when": "false"
        },
        {
          "command": "openLens.copyPortForwardUrl",
          "when": "false"
        },
        {
          "command": "openLens.stopPortForward",
          "when": "false"
        },
        {
          "command": "openLens.importKubeconfigFromEditor",
          "when": "editorIsOpen"
        },
        {
          "command": "openLens.applyYaml",
          "when": "editorIsOpen"
        },
        {
          "command": "openLens.openResource",
          "when": "false"
        },
        {
          "command": "openLens.unpinFavorite",
          "when": "false"
        },
        {
          "command": "openLens.diffWithLive",
          "when": "resourceScheme == k8s"
        },
        {
          "command": "openLens.helmUpgradeFromEditor",
          "when": "openLens.helmValuesEditor"
        },
        {
          "command": "openLens.helmInstallFromEditor",
          "when": "openLens.helmInstallEditor"
        }
      ]
    },
    "configuration": {
      "title": "Kubernetes OpenLens",
      "properties": {
        "openLens.kubeconfig": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Kubeconfig files to load, merged like `$KUBECONFIG` (the first file wins on name clashes and receives imported contexts). When empty, `$KUBECONFIG` or `~/.kube/config` is used."
        },
        "openLens.refreshInterval": {
          "type": "number",
          "default": 5,
          "minimum": 2,
          "description": "Seconds between refreshes of open overview, table and details panels."
        },
        "openLens.confirmDangerousOperations": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before deleting, restarting or scaling to zero."
        },
        "openLens.backupKubeconfig": {
          "type": "boolean",
          "default": true,
          "description": "Keep a timestamped backup (last 5) of a kubeconfig file before importing into it or removing contexts."
        },
        "openLens.logs.tailLines": {
          "type": "number",
          "default": 500,
          "minimum": 0,
          "description": "Number of past log lines to show when opening logs (0 = all)."
        },
        "openLens.logs.timestamps": {
          "type": "boolean",
          "default": false,
          "description": "Prefix log lines with their timestamps."
        },
        "openLens.shell": {
          "type": "string",
          "default": "",
          "markdownDescription": "Command run by `sh -c` when opening a shell in a container. Empty tries `bash`, then `ash`, then `sh`."
        },
        "openLens.portForward.address": {
          "type": "string",
          "default": "127.0.0.1",
          "enum": [
            "127.0.0.1",
            "0.0.0.0",
            "::1"
          ],
          "description": "Local address port forwards listen on. 0.0.0.0 exposes them to your network."
        },
        "openLens.portForward.openInBrowser": {
          "type": "boolean",
          "default": false,
          "description": "Open a new port forward in the browser right away."
        },
        "openLens.kubeconfigFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Folders whose files are all loaded as kubeconfigs and watched for changes, e.g. `~/.kube/configs`. Imports still go to the first kubeconfig file."
        },
        "openLens.protectedContexts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Production contexts: names or patterns like `*prod*`. Changes to them need the context name typed to confirm, and their panels are framed in red."
        },
        "openLens.checkPermissions": {
          "type": "boolean",
          "default": true,
          "description": "Hide actions you have no RBAC permission for (checked with SelfSubjectAccessReview)."
        },
        "openLens.logs.viewer": {
          "type": "string",
          "enum": [
            "panel",
            "terminal"
          ],
          "default": "panel",
          "enumDescriptions": [
            "Log viewer with search, level filter and JSON formatting",
            "A terminal"
          ],
          "description": "Where pod logs open."
        },
        "openLens.nodeShell.image": {
          "type": "string",
          "default": "busybox:1.36",
          "description": "Image of the privileged pod used for node shells (needs nsenter)."
        },
        "openLens.nodeShell.namespace": {
          "type": "string",
          "default": "kube-system",
          "description": "Namespace for node shell pods."
        },
        "openLens.debug.image": {
          "type": "string",
          "default": "busybox:1.36",
          "description": "Default image for ephemeral debug containers."
        },
        "openLens.prometheus": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "markdownDescription": "Prometheus per context as `\"context\": \"namespace/service:port\"`, or `\"off\"`. Without an entry a well-known Prometheus service is detected automatically."
        },
        "openLens.tools": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "markdownDescription": "Paths of command-line tools when they are not on PATH, e.g. `{\"kind\": \"/opt/tools/kind\", \"yc\": \"~/yandex-cloud/bin/yc\"}`. Known: kind, k3d, minikube, helm, yc, aws, gcloud, az, ssh, docker."
        },
        "openLens.yamlSchemas.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Validate and complete Kubernetes manifests with the kinds and CRDs of your cluster (needs the [YAML extension](https://marketplace.visualstudio.com/items?itemName=redhat.vscode-yaml))."
        },
        "openLens.yamlSchemas.context": {
          "type": "string",
          "default": "",
          "description": "Context whose schemas validate manifests in the workspace; empty uses the current context."
        }
      }
    },
    "keybindings": [
      {
        "command": "openLens.goToResource",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k"
      }
    ],
    "languageModelTools": [
      {
        "name": "kubernetes_list_contexts",
        "displayName": "List Kubernetes Contexts",
        "modelDescription": "Lists the kubeconfig contexts with their API server, default namespace and credential problems. The current context is marked with *.",
        "userDescription": "List Kubernetes Contexts",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "k8s-list-contexts",
        "icon": "$(server-environment)",
        "tags": [
          "kubernetes",
          "k8s"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "kubernetes_list_resources",
        "displayName": "List Kubernetes Resources",
        "modelDescription": "Lists resources of one kind like `kubectl get` (pods, deployments, services, nodes, events, configmaps, secrets (names only), ingresses, pvc, helm releases, custom resources…) with status columns and, for pods and nodes, CPU/memory usage.",
        "userDescription": "List Kubernetes Resources",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "k8s-list-resources",
        "icon": "$(server-environment)",
        "tags": [
          "kubernetes",
          "k8s"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "context": {
              "type": "string",
              "description": "Kubeconfig context; defaults to the current context."
            },
            "kind": {
              "type": "string",
              "description": "Resource kind, e.g. pods, deployment, svc, nodes, helmreleases or a CRD kind."
            },
            "namespace": {
              "type": "string",
              "description": "Namespace; empty for all namespaces."
            },
            "labelSelector": {
              "type": "string",
              "description": "Optional label selector, e.g. app=web."
            }
          },
          "required": [
            "kind"
          ]
        }
      },
      {
        "name": "kubernetes_describe_resource",
        "displayName": "Describe Kubernetes Resource",
        "modelDescription": "Describes one resource like `kubectl describe`: status, conditions, containers (state, restarts, last termination, resources, env), related pods, rollout history and recent events. Secret values are never returned.",
        "userDescription": "Describe Kubernetes Resource",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "k8s-describe-resource",
        "icon": "$(server-environment)",
        "tags": [
          "kubernetes",
          "k8s"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "context": {
              "type": "string",
              "description": "Kubeconfig context; defaults to the current context."
            },
            "kind": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ]
        }
      },
      {
        "name": "kubernetes_pod_logs",
        "displayName": "Read Pod Logs",
        "modelDescription": "Returns the last lines of a pod's logs, for one container or all of them; use previous=true for the instance before the last crash.",
        "userDescription": "Read Pod Logs",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "k8s-pod-logs",
        "icon": "$(server-environment)",
        "tags": [
          "kubernetes",
          "k8s"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "context": {
              "type": "string",
              "description": "Kubeconfig context; defaults to the current context."
            },
            "namespace": {
              "type": "string"
            },
            "pod": {
              "type": "string"
            },
            "container": {
              "type": "string"
            },
            "tailLines": {
              "type": "number",
              "description": "Lines per container, default 200, max 2000."
            },
            "previous": {
              "type": "boolean"
            },
            "sinceSeconds": {
              "type": "number"
            }
          },
          "required": [
            "namespace",
            "pod"
          ]
        }
      },
      {
        "name": "kubernetes_events",
        "displayName": "Kubernetes Events",
        "modelDescription": "Returns recent events, newest first; warnings only by default. Filter by namespace or by the name of the involved object.",
        "userDescription": "Kubernetes Events",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "k8s-events",
        "icon": "$(server-environment)",
        "tags": [
          "kubernetes",
          "k8s"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "context": {
              "type": "string",
              "description": "Kubeconfig context; defaults to the current context."
            },
            "namespace": {
              "type": "string"
            },
            "warningsOnly": {
              "type": "boolean",
              "description": "Default true."
            },
            "involvedObject": {
              "type": "string",
              "description": "Name of the object the events are about."
            }
          }
        }
      },
      {
        "name": "kubernetes_cluster_overview",
        "displayName": "Kubernetes Cluster Overview",
        "modelDescription": "Summarises a cluster: node readiness, CPU and memory usage/requests/limits against capacity, pod and workload health, and recent warnings.",
        "userDescription": "Kubernetes Cluster Overview",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "k8s-cluster-overview",
        "icon": "$(server-environment)",
        "tags": [
          "kubernetes",
          "k8s"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "context": {
              "type": "string",
              "description": "Kubeconfig context; defaults to the current context."
            },
            "namespace": {
              "type": "string",
              "description": "Limit pods, workloads and usage to one namespace."
            }
          }
        }
      }
    ],
    "walkthroughs": [
      {
        "id": "openLens.getStarted",
        "title": "Get started with Kubernetes",
        "description": "Get a cluster, set it up, and deploy your first app without leaving VS Code.",
        "steps": [
          {
            "id": "cluster",
            "title": "Get a cluster",
            "description": "Import a kubeconfig you received, create a local cluster with kind, k3d or minikube, connect a managed cluster (Yandex Cloud, EKS, GKE, AKS) or install k3s on your own servers.\n[Add Cluster](command:openLens.addCluster)",
            "media": {
              "markdown": "resources/walkthrough/cluster.md"
            },
            "completionEvents": [
              "onCommand:openLens.addCluster",
              "onCommand:openLens.importKubeconfig",
              "onCommand:openLens.createLocalCluster"
            ]
          },
          {
            "id": "doctor",
            "title": "Check its health",
            "description": "Cluster Doctor checks nodes, DNS, metrics, storage, ingress, failing pods, removed APIs and certificates — with one-click fixes.\n[Run Cluster Doctor](command:openLens.runDoctor)",
            "media": {
              "markdown": "resources/walkthrough/doctor.md"
            },
            "completionEvents": [
              "onCommand:openLens.runDoctor"
            ]
          },
          {
            "id": "addons",
            "title": "Install the essentials",
            "description": "metrics-server, ingress-nginx, cert-manager, Prometheus + Grafana, Loki, Argo CD and more, preconfigured for your cluster.\n[Open Add-ons](command:openLens.openAddons)",
            "media": {
              "markdown": "resources/walkthrough/addons.md"
            },
            "completionEvents": [
              "onCommand:openLens.openAddons"
            ]
          },
          {
            "id": "deploy",
            "title": "Deploy an app",
            "description": "Fill a short form (image, port, domain) and get a Deployment, Service, Ingress with TLS and autoscaling — or convert a docker-compose file.\n[Deploy an Image](command:openLens.deployImage)",
            "media": {
              "markdown": "resources/walkthrough/deploy.md"
            },
            "completionEvents": [
              "onCommand:openLens.deployImage",
              "onCommand:openLens.convertCompose"
            ]
          },
          {
            "id": "team",
            "title": "Give your team access",
            "description": "Create a namespace with quotas and defaults and a ready-to-send kubeconfig with the right permissions.\n[Onboard a Team](command:openLens.onboardTeam)",
            "media": {
              "markdown": "resources/walkthrough/team.md"
            },
            "completionEvents": [
              "onCommand:openLens.onboardTeam"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run check && npm run build",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "compile": "tsc -p ./ --noEmit",
    "typecheck": "tsc -p ./ --noEmit && tsc -p tsconfig.test.json",
    "check": "npm run typecheck",
    "package": "vsce package --no-dependencies",
    "package:list": "vsce ls --no-dependencies",
    "lint": "tsc -p ./ --noEmit",
    "test": "node esbuild.test.js && node --test out/test/*.test.js",
    "test:integration": "node esbuild.test.js && node --test --test-concurrency=1 out/test/integration/*.test.js"
  },
  "dependencies": {
    "@kubernetes/client-node": "~1.4.0",
    "js-yaml": "^4.3.2",
    "tar-fs": "^3.1.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.43",
    "@types/tar-fs": "^2.0.4",
    "@types/vscode": "~1.95.0",
    "@vscode/vsce": "^4.0.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@azure/msal-node": "^7.1.2"
  },
  "icon": "resources/icon.png"
}
