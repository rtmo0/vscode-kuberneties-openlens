{
  "name": "vscode-kuberneties-openlens",
  "displayName": "Kubernetes Explorer & OpenLens Tools",
  "description": "OpenLens-style Kubernetes IDE in VS Code: cluster overview, workloads, pods with live CPU/memory metrics, logs, shells, secrets, port forwarding, Helm releases, YAML editing and safe kubeconfig import.",
  "version": "1.3.3",
  "publisher": "samarin-aa-aka-rtm00",
  "license": "SEE LICENSE IN LICENSE",
  "pricing": "Free",
  "preview": true,
  "galleryBanner": {
    "color": "#326CE5",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rtmo0/vscode-kuberneties-openlens.git"
  },
  "homepage": "https://github.com/rtmo0/vscode-kuberneties-openlens#readme",
  "bugs": {
    "url": "https://github.com/rtmo0/vscode-kuberneties-openlens/issues"
  },
  "sponsor": {
    "url": "https://boosty.to/rtm00"
  },
  "qna": "https://github.com/rtmo0/vscode-kuberneties-openlens/discussions",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "kubernetes",
    "k8s",
    "openlens",
    "lens",
    "kubectl",
    "kubeconfig",
    "cluster",
    "pods",
    "logs",
    "port-forward",
    "helm",
    "secrets",
    "metrics",
    "copilot",
    "prometheus",
    "rbac",
    "kind",
    "k3s",
    "k3d",
    "minikube",
    "eks",
    "gke",
    "aks",
    "yandex-cloud",
    "ingress",
    "cert-manager"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Cluster connections and resource-changing commands require a trusted workspace."
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "onStartupFinished",
    "onFileSystem:k8s"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "openLens",
          "title": "Kubernetes",
          "icon": "resources/kubernetes.svg"
        }
      ]
    },
    "views": {
      "openLens": [
        {
          "id": "openLens.clusters",
          "name": "Clusters",
          "icon": "resources/kubernetes.svg",
          "contextualTitle": "Kubernetes"
        },
        {
          "id": "openLens.favorites",
          "name": "Favorites",
          "icon": "resources/kubernetes.svg",
          "contextualTitle": "Kubernetes"
        },
        {
          "id": "openLens.portForwards",
          "name": "Port Forwards",
          "icon": "resources/kubernetes.svg",
          "contextualTitle": "Kubernetes"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "openLens.clusters",
        "contents": "No Kubernetes contexts found in your kubeconfig.\n[Add Cluster](command:openLens.addCluster)\nImport a kubeconfig you received, create a local cluster (kind, k3d, minikube), connect Yandex Cloud / EKS / GKE / AKS, or install k3s on your servers.\n[Get Started Guide](command:workbench.action.openWalkthrough?%5B%22samarin-aa-aka-rtm00.vscode-kuberneties-openlens%23openLens.getStarted%22%2Cfalse%5D)"
      },
      {
        "view": "openLens.portForwards",
        "contents": "No active port forwards.\nStart one from a pod or service: the Port Forward action in a table, or the Forward button next to a container or service port."
      },
      {
        "view": "openLens.favorites",
        "contents": "Pin resources with the star in their details panel; recently opened resources show up here too.\n[Go to Resource…](command:openLens.goToResource)"
      }
    ],
    "commands": [
      {
        "command": "openLens.importKubeconfig",
        "title": "Import Kubeconfig…",
        "category": "Kubernetes",
        "icon": "$(add)"
      },
      {
