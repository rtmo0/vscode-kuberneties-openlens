    "menus": {
      "view/title": [
        {
          "command": "openLens.addCluster",
          "when": "view == openLens.clusters",
          "group": "navigation@1"
        },
        {
          "command": "openLens.goToResource",
          "when": "view == openLens.clusters",
          "group": "navigation@2"
        },
        {
          "command": "openLens.refreshClusters",
          "when": "view == openLens.clusters",
          "group": "navigation@3"
        },
        {
          "command": "openLens.pasteKubeconfig",
          "when": "view == openLens.clusters",
          "group": "1_import@1"
        },
        {
          "command": "openLens.importKubeconfigFromClipboard",
